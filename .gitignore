/test-output/
/htmlcov/
.tox/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover

# ========================
# Keep these files
# ========================

# Keep empty directories
!.gitkeep
!.keep

# Keep important config files
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
